{
  "name": "scim-bridge",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "react-router typegen && tsc -b --force",
    "typecheck:gate": "node scripts/check-type-gate.mjs",
    "check:registry": "node scripts/check-public-registry.mjs",
    "typecheck:app": "react-router typegen && tsc -p tsconfig.app.json --noEmit",
    "lint": "oxlint app/ workers/ server/ tests/ deploy/",
    "format": "oxfmt --write app server workers tests deploy package.json postcss.config.mjs vite.config.ts react-router.config.ts",
    "format:check": "oxfmt --check app server workers tests deploy package.json postcss.config.mjs vite.config.ts react-router.config.ts",
    "verify": "npm run typecheck && npm run build",
    "test": "vitest run --coverage --reporter=default --reporter=json --outputFile=.vitest/sqlite.json",
    "test:postgres": "cross-env TEST_ENGINE=postgres vitest run --reporter=default --reporter=json --outputFile=.vitest/postgres.json",
    "test:engines": "node scripts/check-engine-parity.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^2.1.0",
    "@radix-ui/react-icons": "^2.0.0-rc.1776195498999",
    "@radix-ui/themes": "^3.3.0",
    "@react-router/node": "^8.3.0",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^7.0.3",
    "hono": "^4.13.1",
    "isbot": "^5.2.1",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tsx": "^4.23.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "postcss": "^8.5.26",
    "postcss-custom-media": "^12.0.1",
    "postcss-hover-media-feature": "^1.0.2",
    "postcss-import": "^16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8",
    "vite-tsconfig-paths": "^6",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
