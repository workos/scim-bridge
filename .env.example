# scim-bridge global configuration.
# Copy to .env and adjust. Per-directory settings (your native SCIM endpoint,
# the WorkOS directory endpoint, tokens, and migration mode) are NOT set here —
# you import each directory through the control panel at /panel.

# --- Networking --------------------------------------------------------------

# Port the server listens on inside the container.
PORT=8080

# Public base URL your IdP uses to reach the proxy. The control panel shows
# "<PUBLIC_URL>/scim/v2" as the SCIM base URL to paste into your IdP.
# Set this to the externally reachable URL (behind your TLS terminator).
# Example: https://scim-bridge.acme.com
PUBLIC_URL=http://localhost:8080

# --- Storage -----------------------------------------------------------------

# Path to the SQLite database file. Mount a volume here so data survives
# restarts (the container defaults this to /data/scim-bridge.db).
DATABASE_PATH=/data/scim-bridge.db

# --- Security ----------------------------------------------------------------

# Optional HTTP Basic credentials protecting the control panel. Leave both
# blank to run the panel unauthenticated (front it with your own reverse proxy
# / SSO instead). The /scim data-plane is always authenticated by its own
# per-connection proxy token regardless of these.
PANEL_AUTH_USER=
PANEL_AUTH_PASSWORD=

# Optional. When set, each directory's native + WorkOS bearer tokens are
# encrypted at rest (AES-256-GCM). Keep it stable — rotating or removing it
# leaves existing encrypted tokens unreadable. Leave blank to store plaintext.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Demo --------------------------------------------------------------------

# Set to true to mount the bundled IdP + native-app simulators under /__demo
# and drive a full end-to-end migration with no real IdP or WorkOS account.
# Leave false in production.
DEMO_MODE=false
