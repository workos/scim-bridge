# scim-bridge global configuration.
# Copy to .env and adjust. Per-directory settings (your native SCIM endpoint,
# the WorkOS directory endpoint, tokens, and migration mode) are NOT set here —
# you import each directory through the control panel at /panel.

# --- Role ---------------------------------------------------------------------

# Which half of a migration this container runs. "bridge" (the default) is the
# product: the migration proxy plus the control panel. "native-app" serves only
# the bundled native app — its SCIM server, DSync listener, and status page at
# the root — so the same image can stand in for the customer's own application
# in an end-to-end run. See docs/runbook.md; the NATIVE_APP block below only
# applies in that role.
APP_ROLE=bridge

# --- Networking --------------------------------------------------------------

# Port the server listens on inside the container.
PORT=8080

# Public base URL your IdP uses to reach the proxy. The control panel shows
# "<PUBLIC_URL>/scim/v2" as the SCIM base URL to paste into your IdP.
# Set this to the externally reachable URL (behind your TLS terminator).
# Example: https://scim-bridge.acme.com
PUBLIC_URL=http://localhost:8080

# --- Storage -----------------------------------------------------------------

# Path to the SQLite database file. Mount a volume here so data survives
# restarts (the container defaults this to /data/scim-bridge.db).
DATABASE_PATH=/data/scim-bridge.db

# --- Security ----------------------------------------------------------------

# Optional HTTP Basic credentials protecting the control panel. Leave both
# blank to run the panel unauthenticated (front it with your own reverse proxy
# / SSO instead). The /scim data-plane is always authenticated by its own
# per-connection proxy token regardless of these.
PANEL_AUTH_USER=
PANEL_AUTH_PASSWORD=

# Optional. When set, each directory's native + WorkOS bearer tokens are
# encrypted at rest (AES-256-GCM). Keep it stable — rotating or removing it
# leaves existing encrypted tokens unreadable. Leave blank to store plaintext.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Customer-app stand-in (APP_ROLE=native-app only) ------------------------

# Bearer token this app requires on its own /scim/v2 — the same value you set as
# the directory's native token on the bridge. Leave blank to keep the random one
# the database seeds (read it back from poc_config: native.scim_token).
NATIVE_SCIM_TOKEN=

# REQUIRED in this role. Signing secret of the WorkOS webhook endpoint that
# delivers Directory Sync events to <PUBLIC_URL>/webhooks/dsync (WorkOS dashboard
# → Webhooks). Every delivery is HMAC-verified against it; the container refuses
# to start without one rather than accept unsigned deliveries on a public URL.
WEBHOOK_SECRET=

# Base URL of the BRIDGE container. The listener reads each directory's
# migration mode from "<BRIDGE_STATUS_URL>/status/directories/{id}" to decide
# whether to apply an event; unset, it can't reach the bridge and stays inert.
# Example: https://scim-bridge.acme.com
BRIDGE_STATUS_URL=

# The directories this app serves, as JSON. Per directory: the WorkOS directory
# id its DSync events carry, and that directory's proxy token from the bridge
# (the listener presents it to the status endpoint). "name" is optional and only
# labels the status page. This is the authoritative set: each boot reconciles the
# stored rows against it, so a directory you drop from here stops resolving
# events (and releases its token) on the next restart.
# Example: [{"workos_directory_id":"directory_01HXYZ","proxy_token":"…","name":"Acme"}]
DIRECTORIES_JSON=

# --- Demo --------------------------------------------------------------------

# Set to true to mount the bundled IdP + native-app simulators under /__demo
# and drive a full end-to-end migration with no real IdP or WorkOS account.
# Leave false in production.
DEMO_MODE=false
