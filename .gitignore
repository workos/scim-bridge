# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.vitest

# react-router build output
/build/
/.react-router/

# local SQLite data
/data/
*.db
*.db-wal
*.db-shm

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is committed as the template)
.env*
!.env.example

# typescript
*.tsbuildinfo

.claude/settings.local.json
.localdata/
